{
  "name": "reversy-orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Private: reached only through the `reversy` Worker's ORCHESTRATOR service binding.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "RUNS", "class_name": "Run" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Run"] }],
  "vars": {
    "DAYTONA_API_URL": "https://app.daytona.io/api",
    "DAYTONA_TARGET": "eu",
    "DAYTONA_SNAPSHOT": "daytona-medium",
    "ORCHESTRATOR_MODEL": "gpt-6.1-sol",
    "WORKER_MODEL": "gpt-6.1-sol",
    "VERIFIER_MODEL": "gpt-6.1-sol",
    "MAX_WORKERS": "12",
    "WORKER_EFFORT": "medium",
    "RUN_MAX_MINUTES": "120"
  }
  // secrets (wrangler secret put / .dev.vars): NICRRON_API_KEY, OPENAI_API_KEY, DAYTONA_API_KEY,
  // SPECTRON_URL, SPECTRON_CONTEXT_ID, SPECTRON_API_KEY, ANCHORBROWSER_API_KEY (evidence capture),
  // SURREALDB_URL, SURREALDB_NAMESPACE, SURREALDB_DATABASE, SURREALDB_USER, SURREALDB_PASSWORD (evidence store),
  // Report storage bindings: see docs/orchestrator/spec.md#report-dissection.
  // EVENTS_WEBHOOK_URL (optional: backend endpoint that receives run events)
}
