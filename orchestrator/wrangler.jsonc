{
  "name": "reversy-orchestrator",
  "main": "src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reversy-storage",
      "database_id": "e28beeb6-5419-4f49-8c55-1af47e9739d8",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "reversy-evidence" }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Private: reached only through the `reversy` Worker's ORCHESTRATOR service binding.
  "workers_dev": false,
  "preview_urls": false,
  // Run records go to D1 through the `reversy` Worker's Records entrypoint (not public).
  "services": [
    { "binding": "RECORDS", "service": "reversy", "entrypoint": "Records" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RUNS", "class_name": "Run" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Run"] }],
  "vars": {
    "DAYTONA_API_URL": "https://app.daytona.io/api",
    "DAYTONA_TARGET": "eu",
    "DAYTONA_SNAPSHOT": "daytona-medium",
    "ORCHESTRATOR_MODEL": "gpt-6-luna",
    "WORKER_MODEL": "gpt-6-luna",
    "VERIFIER_MODEL": "gpt-6-luna",
    "MAX_WORKERS": "12",
    "WORKER_EFFORT": "medium",
    "RUN_MAX_MINUTES": "120"
  }
  // secrets (wrangler secret put / .dev.vars): OPENAI_API_KEY, DAYTONA_API_KEY,
  // ANCHORBROWSER_API_KEY (evidence capture),
  // Report storage bindings: see docs/orchestrator/spec.md#report-dissection.
  // EVENTS_WEBHOOK_URL (optional: backend endpoint that receives run events)
}
